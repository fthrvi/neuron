# Copy to .env and fill in for your deployment, then render the systemd unit:
#   set -a; . ./.env; set +a
#   envsubst < neuron-chain.service.template | sudo tee /etc/systemd/system/neuron-chain.service
SERVICE_USER=youruser
NEURON_DIR=/opt/neuron-chain
NEURON_DATA=/home/youruser
NEURON_CHAIN_SPEC=/etc/neuron/chain-spec.json
